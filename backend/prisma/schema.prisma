// Prisma schema for Footwear Retail ERP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  MANAGEMENT
  SALES_EXECUTIVE
}

enum Gender {
  MEN
  WOMEN
  KIDS
  UNISEX
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  SPLIT
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum StockMovementType {
  PURCHASE
  SALE
  DAMAGE_OUT
  REPAIR_IN
  CLEARANCE_TRANSFER
  ADJUSTMENT
}

enum ClearanceTier {
  FRESH
  NORMAL
  AGEING
  CLEARANCE_RECOMMENDED
  DEEP_CLEARANCE
  DEAD_STOCK
}

enum ClearanceStatus {
  NORMAL_RACK
  ASSORTED_RACK
  DEEP_DISCOUNT_RACK
  SOLD_OUT
}

enum DamageStatus {
  DAMAGED
  UNDER_INSPECTION
  REPAIR_REQUIRED
  UNDER_REPAIR
  REPAIRED
  RETURNED_TO_STOCK
  DISPOSED
  WRITTEN_OFF
}

enum TargetType {
  DAILY
  MONTHLY
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String
  name            String
  role            Role           @default(SALES_EXECUTIVE)
  phone           String?
  avatar          String?
  active          Boolean        @default(true)
  sales           Sale[]
  purchases       Purchase[]
  damagedReported DamagedProduct[] @relation("ResponsibleUser")
  salesTargets    SalesTarget[]
  stockMovements  StockMovement[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  logo      String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  gender    Gender    @default(UNISEX)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Floor {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  level       Int          @default(0)
  departments Department[]
  createdAt   DateTime     @default(now())
}

model Department {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  floorId   String
  floor     Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  racks     Rack[]
  createdAt DateTime @default(now())
}

model Rack {
  id           String     @id @default(uuid())
  name         String
  code         String     @unique
  rackType     String     @default("NORMAL") // NORMAL, ASSORTED, DEEP_DISCOUNT, DISPLAY
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  shelves      Shelf[]
  createdAt    DateTime   @default(now())
}

model Shelf {
  id          String        @id @default(uuid())
  shelfNumber Int
  code        String        @unique
  rackId      String
  rack        Rack          @relation(fields: [rackId], references: [id], onDelete: Cascade)
  locations   RackLocation[]
  createdAt   DateTime      @default(now())
}

model RackLocation {
  id         String           @id @default(uuid())
  shelfId    String
  shelf      Shelf            @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  position   String           // e.g. "01", "08"
  fullCode   String           @unique // e.g. "L1-MEN-M12-S3-P08"
  isOccupied Boolean          @default(false)
  variants   ProductVariant[]
  createdAt  DateTime         @default(now())
}

model Product {
  id               String           @id @default(uuid())
  name             String
  articleNumber    String           @unique
  brandId          String
  brand            Brand            @relation(fields: [brandId], references: [id])
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  gender           Gender           @default(MEN)
  description      String?
  imageUrl         String?
  baseSellingPrice Float
  mrp              Float
  purchasePrice    Float
  status           String           @default("ACTIVE")
  variants         ProductVariant[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ProductVariant {
  id                 String           @id @default(uuid())
  productId          String
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  size               String           // e.g. "UK 7", "UK 8"
  colour             String           // e.g. "Black", "White"
  sku                String           @unique
  barcode            String           @unique
  purchasePrice      Float
  sellingPrice       Float
  mrp                Float
  rackLocationId     String?
  rackLocation       RackLocation?    @relation(fields: [rackLocationId], references: [id])
  displayStockQty    Int              @default(1)
  entryDate          DateTime         @default(now())
  clearanceTier      ClearanceTier    @default(FRESH)
  clearanceStatus    ClearanceStatus  @default(NORMAL_RACK)
  clearanceDiscount  Float            @default(0) // Percentage discount
  clearanceApproved  Boolean          @default(false)
  inventory          Inventory?
  saleItems          SaleItem[]
  purchaseItems      PurchaseItem[]
  stockMovements     StockMovement[]
  damagedRecords     DamagedProduct[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Inventory {
  id              String         @id @default(uuid())
  variantId       String         @unique
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity        Int            @default(0)
  minStockAlert   Int            @default(3)
  maxStock        Int            @default(50)
  lastStockUpdate DateTime       @default(now())
}

model StockMovement {
  id          String            @id @default(uuid())
  variantId   String
  variant     ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Int
  previousQty Int
  newQty      Int
  reason      String?
  referenceId String?
  userId      String?
  user        User?             @relation(fields: [userId], references: [id])
  createdAt   DateTime          @default(now())
}

model Customer {
  id             String   @id @default(uuid())
  name           String
  phone          String   @unique
  email          String?
  address        String?
  totalPurchases Float    @default(0)
  sales          Sale[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Vendor {
  id                String     @id @default(uuid())
  name              String
  code              String     @unique
  contactPerson     String?
  phone             String
  email             String?
  address           String?
  gstin             String?
  creditPeriodDays  Int        @default(30)
  totalPurchases    Float      @default(0)
  outstandingAmount Float      @default(0)
  purchases         Purchase[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Purchase {
  id                String         @id @default(uuid())
  invoiceNumber     String         @unique
  vendorId          String
  vendor            Vendor         @relation(fields: [vendorId], references: [id])
  purchaseDate      DateTime       @default(now())
  totalAmount       Float
  taxAmount         Float          @default(0)
  discountAmount    Float          @default(0)
  grandTotal        Float
  paymentStatus     PaymentStatus  @default(UNPAID)
  paidAmount        Float          @default(0)
  outstandingAmount Float          @default(0)
  dueDate           DateTime?
  notes             String?
  createdById       String?
  createdBy         User?          @relation(fields: [createdById], references: [id])
  items             PurchaseItem[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model PurchaseItem {
  id         String         @id @default(uuid())
  purchaseId String
  purchase   Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Int
  unitCost   Float
  totalCost  Float
}

model Sale {
  id               String        @id @default(uuid())
  invoiceNumber    String        @unique
  customerId       String?
  customer         Customer?     @relation(fields: [customerId], references: [id])
  salesExecutiveId String
  salesExecutive   User          @relation(fields: [salesExecutiveId], references: [id])
  saleDate         DateTime      @default(now())
  subtotal         Float
  discountAmount   Float         @default(0)
  taxAmount        Float         @default(0)
  grandTotal       Float
  paymentMethod    PaymentMethod @default(CASH)
  cashAmount       Float         @default(0)
  upiAmount        Float         @default(0)
  cardAmount       Float         @default(0)
  paymentStatus    String        @default("COMPLETED")
  notes            String?
  items            SaleItem[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model SaleItem {
  id              String         @id @default(uuid())
  saleId          String
  sale            Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  quantity        Int
  unitPrice       Float
  discountPercent Float          @default(0)
  taxPercent      Float          @default(12)
  finalPrice      Float
}

model DamagedProduct {
  id                     String         @id @default(uuid())
  variantId              String
  variant                ProductVariant @relation(fields: [variantId], references: [id])
  damageType             String         // SOLE_DETACHMENT, STITCH_TEAR, SCUFF_SCRATCH, etc.
  quantity               Int            @default(1)
  damageDate             DateTime       @default(now())
  responsibleUserId      String?
  responsibleUser        User?          @relation("ResponsibleUser", fields: [responsibleUserId], references: [id])
  status                 DamageStatus   @default(DAMAGED)
  estimatedRepairCost    Float          @default(0)
  actualRepairCost       Float          @default(0)
  expectedCorrectionDate DateTime?
  disposalDetails        String?
  notes                  String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
}

model SalesTarget {
  id             String     @id @default(uuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType     TargetType @default(MONTHLY)
  startDate      DateTime
  endDate        DateTime
  targetAmount   Float
  targetPairs    Int        @default(0)
  achievedAmount Float      @default(0)
  achievedPairs  Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Expense {
  id            String   @id @default(uuid())
  category      String   // Utilities, Staff Salary, Rent, Maintenance, Packaging, Marketing
  title         String
  amount        Float
  date          DateTime @default(now())
  paymentMethod String   @default("BANK_TRANSFER")
  notes         String?
  createdAt     DateTime @default(now())
}

model CapitalRecord {
  id          String   @id @default(uuid())
  type        String   // INITIAL_INVESTMENT, ADDITIONAL_INVESTMENT, WITHDRAWAL
  amount      Float
  date        DateTime @default(now())
  source      String   // Equity, Partner Loan, Retained Earnings
  description String?
  createdAt   DateTime @default(now())
}

model Notification {
  id        String               @id @default(uuid())
  type      String               // LOW_STOCK, AGEING_STOCK, DEAD_STOCK, CLEARANCE_RECOMMENDED, DAMAGED_REPAIR_DUE, VENDOR_PAYMENT_DUE, OUTSTANDING_PAYMENT
  title     String
  message   String
  severity  NotificationSeverity @default(INFO)
  isRead    Boolean              @default(false)
  link      String?
  createdAt DateTime             @default(now())
}

model StoreSetting {
  id                   String   @id @default(uuid())
  storeName            String   @default("SoleFit Footwear Retail Pvt Ltd")
  tagline              String   @default("Premium Footwear & Athletic Gear")
  phone                String   @default("+91 98765 43210")
  email                String   @default("contact@solefitretail.com")
  address              String   @default("Shop #12-15, Brigade Road, Bangalore, Karnataka - 560001")
  gstin                String   @default("29ABCDE1234F1Z5")
  footwearGstThreshold Float    @default(1000)
  lowGstPercent        Float    @default(5)
  highGstPercent       Float    @default(12)
  currencySymbol       String   @default("₹")
  updatedAt            DateTime @updatedAt
}
